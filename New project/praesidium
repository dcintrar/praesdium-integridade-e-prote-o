<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRAESDIUM - Rede de Proteção</title>
    <style>
        :root {
            /* Cores Oficiais do Direito e da Justiça */
            --law-ruby: #7a1c28; /* Vermelho Rubi do Direito */
            --law-ruby-dark: #531118; 
            --gold: #c5a059; /* Dourado da Balança e da Logo */
            --gold-light: #e5c78f;
            --bg-light: #fdfdfd; /* Off-white para ambiente humanizado */
            --card-bg: #ffffff;
            --text-dark: #2c2525;
            --text-light: #ffffff;
            --danger: #d9383a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Times New Roman', Georgia, 'Segoe UI', serif; /* Toque mais formal e jurídico */
        }

        body {
            background-color: #f3ede2; /* Fundo levemente creme acadêmico */
            color: var(--text-dark);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* Container simulando um Smartphone */
        .app-container {
            width: 100%;
            max-width: 410px;
            height: 840px;
            background-color: var(--card-bg);
            border-radius: 30px;
            box-shadow: 0 12px 35px rgba(83, 17, 24, 0.2);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            border: 8px solid #2b2b2b;
        }

        /* Topo Fixo com Vermelho Rubi e Ouro */
        header {
            background: linear-gradient(135deg, var(--law-ruby), var(--law-ruby-dark));
            color: var(--text-light);
            padding: 15px;
            text-align: center;
            border-bottom: 4px solid var(--gold);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
        }

        .logo-placeholder {
            width: 50px;
            height: 50px;
            background-color: var(--gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--law-ruby-dark);
            font-size: 22px;
            box-shadow: 0 0 10px rgba(0,0,0,0.3);
            border: 2px solid white;
        }

        header h1 {
            font-size: 20px;
            letter-spacing: 1.5px;
            color: var(--gold-light);
            font-weight: 700;
        }

        header p {
            font-size: 11px;
            font-family: 'Segoe UI', sans-serif;
            letter-spacing: 2px;
            opacity: 0.9;
        }

        /* Área do Conteúdo */
        .app-content {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            padding-bottom: 85px;
            background-color: var(--bg-light);
        }

        .screen {
            display: none;
        }

        .screen.active {
            display: block;
        }

        h2 {
            color: var(--law-ruby);
            font-size: 22px;
            margin-bottom: 15px;
            border-left: 4px solid var(--gold);
            padding-left: 8px;
            font-weight: bold;
        }

        p {
            font-size: 14.5px;
            line-height: 1.6;
            margin-bottom: 15px;
            text-align: justify;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .alert-box {
            background-color: rgba(217, 56, 58, 0.08);
            border: 1px solid var(--danger);
            border-radius: 10px;
            padding: 12px;
            color: #8c1c1e;
            font-size: 13.5px;
            margin-bottom: 15px;
            font-family: 'Segoe UI', sans-serif;
        }

        /* Botões Estilizados */
        .btn {
            display: block;
            width: 100%;
            padding: 13px;
            background-color: var(--law-ruby);
            color: white;
            border: 1px solid var(--gold);
            border-radius: 8px;
            text-align: center;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            margin-bottom: 11px;
            transition: all 0.2s;
            text-decoration: none;
            font-family: 'Segoe UI', sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn:hover {
            background-color: var(--gold);
            color: var(--law-ruby-dark);
            border-color: var(--law-ruby);
        }

        .btn-secondary {
            background-color: transparent;
            color: var(--law-ruby);
            border: 2px solid var(--law-ruby);
        }

        .btn-secondary:hover {
            background-color: var(--law-ruby);
            color: white;
        }

        .btn-danger {
            background-color: var(--danger);
            border-color: #b52224;
            color: white;
        }
        .btn-danger:hover {
            background-color: #b52224;
            color: white;
        }

        /* Grid de opções */
        .menu-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 15px;
        }

        .grid-item {
            background-color: white;
            border: 2px solid #e8e2d8;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
            transition: all 0.2s;
            color: var(--law-ruby);
            font-family: 'Segoe UI', sans-serif;
        }

        .grid-item:hover {
            border-color: var(--gold);
            background-color: rgba(197, 160, 89, 0.08);
            transform: translateY(-2px);
        }

        /* Checklist */
        .checklist-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 12px;
            background: #f7f3eb;
            padding: 12px;
            border-radius: 8px;
            border-left: 3px solid var(--gold);
            font-family: 'Segoe UI', sans-serif;
            font-size: 13.5px;
        }

        .checklist-item input {
            margin-top: 4px;
            transform: scale(1.2);
            accent-color: var(--law-ruby);
        }

        ul li {
            font-family: 'Segoe UI', sans-serif;
        }

        .info-card {
            background: #fff;
            border: 1px solid #e8e2d8;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 10px;
            font-family: 'Segoe UI', sans-serif;
            font-size: 14px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        }

        /* Barra de Acesso Rápido Fixa */
        .emergency-bar {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            background-color: #fff;
            border-top: 2px solid #e8e2d8;
            padding: 10px 15px;
            display: flex;
            gap: 10px;
            z-index: 100;
        }

        .emergency-bar a {
            flex: 1;
            padding: 11px;
            font-size: 12px;
            margin-bottom: 0;
        }
    </style>
</head>
<body>

<div class="app-container">
    <!-- Topo Rubro e Ouro da Justiça -->
    <header>
